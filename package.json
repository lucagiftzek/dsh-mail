{
  "name": "dsh-mail",
  "version": "0.2.0",
  "description": "Mail for agents and humans in the DeepSeek Harness: IMAP, POP3 and SMTP accounts, Gmail with an app password, Tzekos Mail, Lettermint, Resend and AgentMail; a local cache, a Mail sidebar tab with a reading view, an accounts editor in DSH Settings, and mail_* agent tools with draft-first sending.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "for f in lib/*.js; do node --check $f || exit 1; done && node test/run.mjs",
    "build": "node scripts/build.mjs",
    "test": "node test/run.mjs",
    "probe-presets": "node scripts/probe-presets.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-better-sidebar",
    "email",
    "send",
    "mass-send",
    "schedule",
    "lettermint",
    "agentmail",
    "resend",
    "ovh",
    "smtp",
    "imap",
    "pop3",
    "imapflow",
    "webmail",
    "mail-client"
  ],
  "author": {
    "name": "Loukas \"Luca\" Tzekos",
    "url": "https://jobopportunitiesapi.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucagiftzek/dsh-mail.git"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "hoodiecrow-imap": "^3.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smtp-server": "^3.21.3"
  },
  "dependencies": {
    "html-to-text": "^10.0.1",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "marked": "^18.1.2",
    "nodemailer": "^10.3.1",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1"
  }
}
